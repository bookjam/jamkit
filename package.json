{
    "name": "jamkit",
    "version": "0.99.15",
    "description": "A simple native app framework",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "jamkit": "dist/index.js"
    },
    "files": [
        "dist/**",
        "browsers",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsc -w -p tsconfig.json",
        "start": "node dist/index.js",
        "prepare": "npm run build",
        "typecheck": "tsc --noEmit"
    },
    "engines": {
        "node": ">=18.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bookjam/jamkit.git"
    },
    "bugs": {
        "url": "https://github.com/bookjam/jamkit/issues"
    },
    "keywords": [
        "jamkit",
        "app"
    ],
    "homepage": "https://github.com/bookjam/jamkit",
    "author": "Hanyeol Cho <hanyeol.cho@gmail.com>",
    "license": "MIT",
    "dependencies": {
        "@devicefarmer/adbkit-apkreader": "^3.2.4",
        "array-extended": "^0.0.11",
        "axios": "^1.8.4",
        "chokidar": "^3.4.3",
        "commander": "^9.4.1",
        "fast-xml-parser": "^4.3.2",
        "fetch-repo-dir": "^1.0.4",
        "fs-extra": "^8.1.0",
        "glob": "^10.3.10",
        "inquirer": "^9.1.3",
        "ipfs-http-client": "^56.0.3",
        "is-empty-object": "^1.1.1",
        "is-object": "^1.0.1",
        "javascript-obfuscator": "^4.1.0",
        "node-sqlite3-wasm": "^0.8.0",
        "path": "^0.12.7",
        "qrcode-terminal": "^0.12.0",
        "shelljs": "^0.8.4",
        "simctl": "^2.0.3",
        "simple-plist": "^1.0.0",
        "sprintf-js": "^1.1.2",
        "tmp": "^0.2.5",
        "typescript": "^5.7.2",
        "uglify-js": "^3.7.5",
        "urlencode": "^1.1.0",
        "uuid": "^8.3.2",
        "walk-sync": "^3.0.0",
        "xcode": "^3.0.1",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
        "zip-dir": "^2.0.0"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/inquirer": "^9.0.9",
        "@types/node": "^24.5.2",
        "@types/qrcode-terminal": "^0.12.2",
        "@types/shelljs": "^0.8.17",
        "@types/sprintf-js": "^1.1.4",
        "@types/tmp": "^0.2.6",
        "@types/urlencode": "^1.1.4",
        "@types/uuid": "^10.0.0"
    }
}
